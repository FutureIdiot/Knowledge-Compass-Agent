# 默认模型配置
# 可选 provider: glm / siliconflow
LLM_PROVIDER=siliconflow
MODEL_NAME=deepseek-ai/DeepSeek-V3

# provider 对应的 key
# GLM_API_KEY=your_glm_key_here
SILICONFLOW_API_KEY=your_siliconflow_key_here

# 也可以给不同 agent 单独指定 provider / model
# 不写则继承上面的全局默认值
#
# CONTROLLER_LLM_PROVIDER=glm
# CONTROLLER_MODEL_NAME=glm-4-flash
#
# RESPONDER_LLM_PROVIDER=siliconflow
# RESPONDER_MODEL_NAME=deepseek-ai/DeepSeek-V3
#
# MEMORY_MANAGER_LLM_PROVIDER=glm
# MEMORY_MANAGER_MODEL_NAME=glm-4-flash
#
# PROFILE_MANAGER_LLM_PROVIDER=glm
# PROFILE_MANAGER_MODEL_NAME=glm-4-flash
#
# KNOWLEDGE_MANAGER_LLM_PROVIDER=siliconflow
# KNOWLEDGE_MANAGER_MODEL_NAME=deepseek-ai/DeepSeek-V3
#
# WEB_SEARCHER_LLM_PROVIDER=siliconflow
# WEB_SEARCHER_MODEL_NAME=deepseek-ai/DeepSeek-V3

# web search 配置
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5
